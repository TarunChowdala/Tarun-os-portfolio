# Gemini (required) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated browser origins allowed to call this API
# Include your Vercel portfolio URL in production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-portfolio.vercel.app
